# ==========================================
# Varun M Portfolio - Environment Variables
# ==========================================

# Port for the Node.js server (Default: 3000)
PORT=3000

# Nodemailer Configuration
# Option 1: Gmail (Recommended & easiest)
# Create an App Password at: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Target email to receive portfolio contact submissions
RECIPIENT_EMAIL=malthumkarvarun@gmail.com

# Option 2: Custom SMTP (Optional, leave commented out if using Gmail)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
